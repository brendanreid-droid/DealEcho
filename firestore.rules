rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isPro() {
      return isSignedIn()
        && request.auth.token.role in ['paid', 'admin', 'free_full'];
    }

    // Give-to-get: a temporary full-review unlock earned by writing a first
    // review. Backed by a self-expiring `reviewUnlockUntil` custom claim
    // (epoch seconds), so access lapses automatically with no cleanup job.
    function hasReviewUnlock() {
      return isSignedIn()
        && request.auth.token.reviewUnlockUntil is int
        && request.auth.token.reviewUnlockUntil > request.time.toMillis() / 1000;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isEnterpriseManager(teamId) {
      return isSignedIn()
        && request.auth.token.teamId == teamId
        && request.auth.token.teamRole == 'manager';
    }

    function isTeamMember(teamId) {
      return isSignedIn()
        && request.auth.token.teamId == teamId;
    }

    // ── Review Summaries ────────────────────────────────────────────────────────
    // Public read. Only Cloud Function (Admin SDK) can write.
    match /review_summaries/{summaryId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Reviews ────────────────────────────────────────────────────────────────
    // Only Pro members can read reviews. Only authenticated users can create.
    // Users cannot set moderation fields — only Cloud Functions (Admin SDK) can.
    // Admins can moderate (update/delete).
    match /reviews/{reviewId} {
      // Pro users read all reviews; users with an active give-to-get unlock
      // read all reviews too; any signed-in user can always read their OWN
      // reviews (so they can see a rejected review + its moderation reason).
      allow read: if isPro()
                  || hasReviewUnlock()
                  || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Reviews are created/edited exclusively via the submitReview /
      // resubmitReview callables (Admin SDK, bypasses rules). This enforces the
      // 6-month-per-company rate limit that rules alone cannot express.
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // "Was this helpful?" votes, one document per voter, id == their uid.
    //
    // A user may read ONLY their own vote — enough to render the button in the
    // pressed state, and nothing more. Reading someone else's would turn an
    // anonymous signal into "who endorsed this review", which is exactly the
    // attribution sellers are promised they do not have here. The aggregate
    // lives on the parent review as `helpfulCount`.
    //
    // Writes are closed: the vote and the counter have to move together, which
    // only the toggleReviewHelpful callable can guarantee. A client that could
    // write here could vote for itself or desync the count.
    match /reviews/{reviewId}/helpfulVotes/{voterId} {
      allow read: if isSignedIn() && voterId == request.auth.uid;
      allow write: if false;
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    // Users can read their own profile; admins can read all.
    // Users can ONLY update safe preference fields — billing/role fields are
    // written exclusively by Cloud Functions via the Admin SDK (bypasses rules).
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      // Full write for admins (Admin SDK bypasses rules anyway, but this covers
      // any future admin panel writes that use the client SDK).
      allow write: if isAdmin();

      // Users can update only their own safe fields.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['trackedCompanies', 'notificationPreferences', 'updatedAt']);
    }

    // ── Companies ─────────────────────────────────────────────────────────────
    // Public read. Admins can manage data.
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Webhook Debug Logs ──────────────────────────────────────────────────────
    // Written by backend Cloud Functions (uses Admin SDK, bypasses rules).
    // No client-side access.
    match /webhooks_debug/{logId} {
      allow read, write: if false;
    }

    // ── Health checks ─────────────────────────────────────────────────────────
    // Written by the daily runHealthCheck schedule (Admin SDK). Server-only:
    // it records operational state, not user data. Admins read it through the
    // adminGetHealthReport callable.
    match /health_checks/{checkId} {
      allow read, write: if false;
    }

    // ── Referrals ─────────────────────────────────────────────────────────────
    // Written exclusively by Cloud Functions (Admin SDK, bypasses rules).
    // Closed to all clients: the document id IS the invite token, so any read
    // access would let a caller enumerate live tokens and hijack referrals.
    // The /referrals page reads through the getReferralStatus callable instead.
    match /referral_invites/{token} {
      allow read, write: if false;
    }

    // Per-user invite send counters. Server-only for the same reason.
    match /referral_quota/{userId} {
      allow read, write: if false;
    }

    // Per-user reward ledger. This is the authoritative record of the 12/year
    // cap, reserved transactionally during payout, so it must never be
    // client-writable. Read it through getReferralStatus.
    match /referral_rewards/{userId} {
      allow read, write: if false;
    }

    // ── Config (pricing, etc.) ────────────────────────────────────────────────
    // Anyone can read config (pricing page needs it). Only admins can write.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Private config (retention coupons, etc.) ───────────────────────────────
    // Server-only: read exclusively by Cloud Functions (Admin SDK bypasses
    // rules). Never exposed to the client so coupon IDs stay private.
    match /private_config/{docId} {
      allow read, write: if false;
    }

    // ── Cancellation feedback ──────────────────────────────────────────────────
    // Written by the cancelSubscription callable (Admin SDK). Admins read for
    // retention analysis; clients never read or write directly.
    match /cancellation_feedback/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Newsletters (campaign history) ──────────────────────────────────────────
    // Only administrators can read or write campaign analytics.
    match /newsletters/{newsletterId} {
      allow read, write: if isAdmin();
      
      match /opens/{uid} {
        allow read, write: if isAdmin();
      }
    }

    // ── Teams ─────────────────────────────────────────────────────────────────
    // Only team members can read. Cloud Functions (Admin SDK) only for writes.
    match /teams/{teamId} {
      allow read: if isTeamMember(teamId);
      allow write: if false;

      match /members/{memberId} {
        allow read: if isTeamMember(teamId);
        allow write: if false;
      }
    }

  }
}
